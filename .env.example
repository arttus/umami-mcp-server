# ---------------------------------------------------------------------------
# Umami Cloud
# ---------------------------------------------------------------------------
# Settings -> API keys -> Create key
UMAMI_API_KEY=your-cloud-api-key
# Optional. 'us' or 'eu'. Defaults to the region of the account owning the key.
# UMAMI_REGION=us

# ---------------------------------------------------------------------------
# Self-hosted (use instead of the Cloud block above)
# ---------------------------------------------------------------------------
# UMAMI_BASE_URL=https://analytics.example.com
# Either an API key on the instance...
# UMAMI_API_KEY=your-self-hosted-key
# ...or a username and password, exchanged for a bearer token automatically.
# UMAMI_USERNAME=admin
# UMAMI_PASSWORD=your-password

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# IANA timezone used for day boundaries and time-series buckets.
UMAMI_TIMEZONE=America/New_York
# Website ID, name, or domain used when a tool call omits the 'website' argument.
# UMAMI_DEFAULT_WEBSITE=example.com
